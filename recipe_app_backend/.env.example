# Recipe Hub Backend (FastAPI)
# Copy to .env and fill in values (do not commit .env)

# PostgreSQL SQLAlchemy URL, e.g.:
# postgresql+psycopg2://postgres:postgres@localhost:5432/recipe_hub
DATABASE_URL=

# JWT signing secret (use a strong random value)
JWT_SECRET_KEY=

# Optional:
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
